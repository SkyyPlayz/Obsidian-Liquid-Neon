{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["dom", "es6", "dom.iterable"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true
  },
  "include": ["**/*.ts"]
}
